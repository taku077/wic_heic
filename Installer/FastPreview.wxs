<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
<Package Id="taku077.WicHeicFastPreview" Name="WicHeic Fast Thumbnail Preview (Experimental)" Manufacturer="WicHeic Community Experimental" Version="0.1.0" Scope="perUser">
 <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="Newer preview already installed."/>
 <Media Id="1" Cabinet="FastPreview.cab" EmbedCab="yes"/>
 <Property Id="PRIOR_HEIC_EXT"><RegistrySearch Id="PriorHeicExt" Root="HKCU" Key="Software\Classes\.heic\ShellEx\{E357FCCD-A995-4576-B01F-234630154E96}" Type="raw"/></Property>
 <Property Id="PRIOR_HEIC_SYSTEM"><RegistrySearch Id="PriorHeicSystem" Root="HKCU" Key="Software\Classes\SystemFileAssociations\.heic\ShellEx\{E357FCCD-A995-4576-B01F-234630154E96}" Type="raw"/></Property>
 <Property Id="PRIOR_HEIC_WIC"><RegistrySearch Id="PriorHeicWic" Root="HKLM" Key="Software\Classes\CLSID\{0E8AB687-73A5-455B-8C19-B93CA9AC0EEB}\InprocServer32" Type="raw"/></Property>
 <Launch Condition="Installed OR (NOT PRIOR_HEIC_EXT AND NOT PRIOR_HEIC_SYSTEM)" Message="Existing per-user HEIC thumbnail handler: refusing to overwrite."/>
 <Launch Condition="Installed OR PRIOR_HEIC_WIC" Message="WicHeic WIC decoder must already be installed."/>
 <Feature Id="Main"><ComponentGroupRef Id="FastThumb"/></Feature>
</Package>
<Fragment>
 <StandardDirectory Id="LocalAppDataFolder"><Directory Id="INSTALLFOLDER" Name="WicHeicFastPreview"/></StandardDirectory>
 <ComponentGroup Id="FastThumb" Directory="INSTALLFOLDER">
  <Component Id="FastServer" Guid="{6B295A88-3968-4D92-AE82-F0A72CB4A20C}">
   <RemoveFolder Id="RemoveFastPreviewFolder" Directory="INSTALLFOLDER" On="uninstall"/>
   <File Id="FastThumbDll" Source="..\wictest\isolated_shell\(Build)\x64\Release\WicHeicFastPreview.dll" KeyPath="no"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{D973196C-165C-4FCE-8838-17C37037D384}\InprocServer32" Type="string" Value="[#FastThumbDll]" KeyPath="yes"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{D973196C-165C-4FCE-8838-17C37037D384}\InprocServer32" Name="ThreadingModel" Type="string" Value="Apartment"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\.heic\ShellEx\{E357FCCD-A995-4576-B01F-234630154E96}" Type="string" Value="{D973196C-165C-4FCE-8838-17C37037D384}"/>
   <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.heic\ShellEx\{E357FCCD-A995-4576-B01F-234630154E96}" Type="string" Value="{D973196C-165C-4FCE-8838-17C37037D384}"/>
  </Component>
 </ComponentGroup>
</Fragment>
</Wix>